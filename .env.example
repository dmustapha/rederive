# ── API (rederive-app/api) ──────────────────────────────────────────────
# Demo mode: 1 = payments waived (public instance), 0 = enforce x402
DEMO_FREE=1
# Admin gate for /amnesia, /restore, /edit, /doctrine (set to any secret)
ADMIN_TOKEN=change-me
# Where the SQLite memory lives (persisted; re-hydrated from baked seed on boot)
REDERIVE_DB=/var/rederive/memory.db

# LLM ladder (live re-derivation on edit). Any ONE provider is enough.
# Native DeepSeek — reachable from datacenter hosts (Render); primary rung.
DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat
# Agent Router (Anthropic /v1/messages wire format) — premium rungs.
AGENTROUTER_API_KEY=
# AGENTROUTER_BASE_URL=https://agentrouter.org/v1

# x402 settlement (only needed when DEMO_FREE=0)
# X402_RECEIVE_ADDRESS=0x...

# Allowed browser origins for CORS (comma-separated)
CORS_ORIGIN=http://localhost:3000

# Optional: Litestream replication for free-tier persistence
# LITESTREAM_BUCKET=
# LITESTREAM_ENDPOINT=
# LITESTREAM_ACCESS_KEY_ID=
# LITESTREAM_SECRET_ACCESS_KEY=

# ── UI (rederive-app/web/.env.local) ────────────────────────────────────
# Public API base the browser calls
NEXT_PUBLIC_API_URL=http://localhost:8402
# Prefill the operator-console admin token (demo convenience)
NEXT_PUBLIC_DEMO_ADMIN_TOKEN=
